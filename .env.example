# Get free keys at https://aistudio.google.com/apikey
# Single key:
# GEMINI_API_KEY=your-key-here
# Multiple keys (auto-rotate, comma-separated — recommended for free tier):
GEMINI_API_KEY=key1,key2,key3
# Also supported: GEMINI_API_KEYS=key1,key2
GEMINI_MODEL=gemini-3.5-flash-lite
# Max AI reads per minute PER KEY (free tier ~10, pro higher)
GEMINI_RPM=10
PORT=3001
